/*--------------------------------*- C++ -*----------------------------------*\
  Microfiber filter v7 - OpenFOAM case (values filled by scripts/setup_case.py)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);
boundaryField
{
    inlet
    {
        type            flowRateInletVelocity;
        volumetricFlowRate constant @@Q_IN@@;     // m3/s
        extrapolateProfile no;
        value           uniform (0 0 0);
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }
    overflow
    {
@@OVERFLOW_U@@
    }
    walls { type noSlip; }
}
